---
import Layout from "../layouts/Layout.astro";
import { createSEO } from "@/utils/seo";
import { getFAQPageSchema } from "@/lib/schemas";

const faqs = [
  {
    question: "Who do you typically work with?",
    answer: "Considered Shopify and Shopify Plus brands that have outgrown the template-and-plugin stage. Most are direct-to-consumer, doing real volume, with a storefront that carries the whole customer relationship. The other thing they share is an operator who can say what the store needs to do and then let engineers decide how. We also work underneath in-house teams as the engineering layer when that fits better."
  },
  {
    question: "How is this different from a typical Shopify agency?",
    answer: "We're engineers first. Most Shopify agencies grew out of design studios and picked up code along the way; our background is production systems at scale, including fintech, where a bad deploy costs money within minutes. That changes how the work runs. We trace a problem to root cause before touching anything, and we build on native Shopify primitives like Functions and app extensions instead of adding another app subscription. Every build sprint is measured against one metric agreed before we start."
  },
  {
    question: "Do you take on early-stage stores or one-off projects?",
    answer: "Generally, no. Our work assumes existing traction and enough order volume that a conversion or performance change shows up in the data within weeks. Below that, a theme partner or a good solo developer will serve you better and cost you far less. One-off projects usually get the same answer: if there's no system behind the request and no follow-through after it ships, we'll point you elsewhere."
  },
  {
    question: "How long does an engagement take?",
    answer: "A Diagnostic runs two to three weeks. A Build Sprint runs four to eight weeks depending on which system we're engineering and how much of it already exists. An Embedded Partnership has no end date and bills monthly. In practice, timelines move on two things: how clean the existing codebase is, and how quickly decisions get made on your side. You get a dated plan before any work starts."
  },
  {
    question: "Do you publish pricing?",
    answer: "No, and we think that's the right call. Two brands can ask for the same thing and need completely different amounts of engineering behind it, so a published price list would either overcharge one of them or quietly shrink the scope to fit the number. You get a clear investment range in the first conversation, before there's any proposal to sign. There's also a written breakdown on the site comparing retainer, hourly, and project-based billing if you want to weigh the models first."
  },
  {
    question: "What happens in the first conversation?",
    answer: "A free 30-minute call. We ask what the store is supposed to do and where it stops doing it, then tell you which engagement fits and roughly what it costs. If the problem doesn't need engineering, we'll say so on the call. Written next steps follow within 24 hours either way."
  },
  {
    question: "Where are you based and how do you work with international brands?",
    answer: "We're based in India and run engagements across time zones. Most of the work moves in writing, so decisions and tradeoffs stay on the record instead of getting stuck in a call half the team missed. Sync calls are scheduled rather than ad hoc: a weekly review, plus live time whenever a decision needs it. Overlap hours get agreed at kickoff and we hold to them."
  },
  {
    question: "Do we own everything you build?",
    answer: "Yes. Code ships into your Shopify store and your repositories, documented well enough that another engineer can take it over without calling us. Diagnostic roadmaps are yours to keep and execute in-house if you'd rather. Nothing we build sits behind a proprietary app or an account you can't access."
  },
  {
    question: "Do you work on Shopify Plus?",
    answer: "Yes, and a good share of our work is on Plus. The four systems we engineer (conversion, merchandising, performance, and custom) apply to both, but Plus opens up primitives that change what's worth building: Shopify Functions for discount and checkout logic, checkout extensibility, B2B, and headless storefronts where the catalogue justifies the cost. On standard Shopify we stay inside Liquid, app extensions, and the Admin API, which covers more than most brands assume."
  }
];

const seo = createSEO({
  pageName: "Shopify Development FAQ",
  description: "Straight answers on working with Capaxe Labs: who we take on, how long engagements run, pricing, time zones, code ownership, and Shopify Plus.",
  keywords: "Shopify development FAQ, Shopify agency questions, Shopify retainer pricing, Shopify Plus development, hiring a Shopify engineering team",
  contentType: "faq",
  pathname: "/faq"
});
seo.structuredData = getFAQPageSchema(faqs);
---

<Layout seo={seo}>
  <main class="min-h-screen">
    <section class="pt-32 pb-8 px-6">
      <div class="max-w-3xl mx-auto text-center">
        <h1 class="text-5xl font-bold mb-4 text-foreground">Frequently Asked Questions</h1>
        <p class="text-lg text-muted-foreground mb-8">How we work, who we take on, what engagements cost, and how long they run. If your question is missing, ask it directly.</p>
      </div>
    </section>

    <!-- FAQ Categories -->
    <section class="px-6 pb-4">
      <div class="max-w-3xl mx-auto">
        <div class="flex flex-wrap justify-center gap-2 mb-8">
          <button class="px-5 py-2 bg-primary-500 text-white text-sm rounded-full font-medium">All</button>
          <button class="px-5 py-2 bg-foreground/5 text-muted-foreground hover:text-foreground hover:bg-foreground/10 text-sm rounded-full transition-colors">Services</button>
          <button class="px-5 py-2 bg-foreground/5 text-muted-foreground hover:text-foreground hover:bg-foreground/10 text-sm rounded-full transition-colors">Process</button>
          <button class="px-5 py-2 bg-foreground/5 text-muted-foreground hover:text-foreground hover:bg-foreground/10 text-sm rounded-full transition-colors">Pricing</button>
          <button class="px-5 py-2 bg-foreground/5 text-muted-foreground hover:text-foreground hover:bg-foreground/10 text-sm rounded-full transition-colors">Support</button>
        </div>
      </div>
    </section>

    <!-- FAQ Items -->
    <section class="px-6 pb-16">
      <div class="max-w-3xl mx-auto space-y-3">
        {faqs.map((faq, index) => (
          <div class="faq-item bento-tile p-0 overflow-hidden">
            <button class="flex justify-between items-center w-full px-6 py-5 text-left hover:bg-foreground/5 transition-colors">
              <span class="text-sm font-medium text-foreground pr-4">{faq.question}</span>
              <svg class="h-5 w-5 text-muted-foreground flex-shrink-0 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
              </svg>
            </button>
            <div class={index === 0 ? "px-6 pb-5" : "hidden px-6 pb-5"}>
              <p class="text-sm text-muted-foreground leading-relaxed">{faq.answer}</p>
            </div>
          </div>
        ))}

        <div class="bento-tile-accent text-center mt-8 py-10">
          <p class="text-lg text-white/80 mb-4">Don't see your question here?</p>
          <a href="/contact" class="inline-block bg-white text-primary-600 py-2.5 px-6 rounded-xl text-sm font-medium hover:bg-gray-100 transition-colors">
            Contact Us
          </a>
        </div>
      </div>
    </section>
  </main>
</Layout>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const faqItems = document.querySelectorAll(".faq-item");

    faqItems.forEach((item) => {
      const button = item.querySelector("button");
      button?.addEventListener("click", () => {
        const content = button.nextElementSibling as HTMLElement | null;
        if (content) {
          content.classList.toggle("hidden");
          const svg = button.querySelector("svg");
          if (svg) {
            svg.classList.toggle("rotate-180");
          }
        }
      });
    });
  });
</script>
