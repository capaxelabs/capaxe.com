---
// INTERNAL TOOL — not linked from anywhere, excluded from sitemap, noindex.
// WhatsApp lead-handling scripts for the ₹5,000 anchored Shopify store offer.
const updated = "13 August 2026";

// Shopify App Store deep links that open the "write a review" box directly.
const reviewApps = [
  { name: "Bee Migration", slug: "bee-migration", blurb: "moving your store over" },
  { name: "Bee LLMs SEO", slug: "bee-llms-seo", blurb: "getting your store AI-search ready" },
  { name: "RankFlo", slug: "rankflo", blurb: "sorting your collections" },
  { name: "ShootFlo Studio", slug: "shootflo-studio", blurb: "your ad creatives" },
  { name: "Bee Secret Gift", slug: "bee-secret-gift", blurb: "your gifting setup" },
  { name: "Bee Invoices", slug: "bee-invoices", blurb: "your invoicing" },
  { name: "Bee Reviews", slug: "bee-reviews", blurb: "collecting your product reviews" },
  { name: "Bee Subscriptions", slug: "bee-subscriptions", blurb: "your subscriptions" },
];

const reviewUrl = (slug: string) =>
  `https://apps.shopify.com/${slug}#modal-show=WriteReviewModal`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow, noarchive, nosnippet, noimageindex" />
    <meta name="googlebot" content="noindex, nofollow" />
    <meta name="referrer" content="no-referrer" />
    <title>WhatsApp Lead Scripts — Internal</title>
    <style>
      :root {
        --cream: #f5efe6;
        --charcoal: #2b2b2b;
        --terracotta: #c96f4a;
        --muted: #7d746a;
        --line: #e3d9cc;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        background: var(--cream);
        color: var(--charcoal);
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Inter, Roboto, sans-serif;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
      }
      .wrap { max-width: 780px; margin: 0 auto; padding: 48px 20px 96px; }
      header.page { border-bottom: 2px solid var(--line); padding-bottom: 20px; margin-bottom: 36px; }
      h1 { font-size: 30px; margin: 0 0 6px; letter-spacing: -0.02em; }
      .sub { color: var(--muted); font-size: 14px; margin: 0; }
      h2 {
        font-size: 13px; text-transform: uppercase; letter-spacing: 0.09em;
        color: var(--terracotta); margin: 44px 0 14px; font-weight: 700;
      }
      h3 { font-size: 16px; margin: 22px 0 8px; }
      p { margin: 0 0 12px; }
      .note {
        font-size: 14px; color: var(--muted); background: #fff;
        border-left: 3px solid var(--terracotta); padding: 12px 14px;
        border-radius: 0 8px 8px 0; margin: 0 0 18px;
      }
      .msg {
        position: relative; background: #fff; border: 1px solid var(--line);
        border-radius: 12px; margin: 0 0 16px; overflow: hidden;
      }
      .msg pre {
        margin: 0; padding: 18px 18px 18px; white-space: pre-wrap; word-wrap: break-word;
        font-family: inherit; font-size: 15px; line-height: 1.65;
      }
      .copy {
        position: absolute; top: 10px; right: 10px; border: 1px solid var(--line);
        background: var(--cream); color: var(--charcoal); font: inherit; font-size: 12px;
        font-weight: 600; padding: 5px 12px; border-radius: 999px; cursor: pointer;
        transition: background .15s, color .15s, border-color .15s;
      }
      .copy:hover { background: var(--terracotta); color: #fff; border-color: var(--terracotta); }
      .copy.done { background: #1f7a4d; color: #fff; border-color: #1f7a4d; }
      ol.order { background: #fff; border: 1px solid var(--line); border-radius: 12px; padding: 18px 18px 18px 38px; }
      ol.order li { margin-bottom: 6px; }
      ul.rules li { margin-bottom: 8px; }
      .row {
        display: flex; align-items: center; gap: 12px; flex-wrap: wrap;
        background: #fff; border: 1px solid var(--line); border-radius: 12px;
        padding: 12px 14px; margin: 0 0 10px;
      }
      .row .app { font-weight: 700; min-width: 150px; }
      .row .url { flex: 1; min-width: 230px; font-size: 12.5px; color: var(--muted); word-break: break-all; }
      .row .url a { color: var(--muted); }
      .btn {
        border: 1px solid var(--line); background: var(--cream); color: var(--charcoal);
        font: inherit; font-size: 12px; font-weight: 600; padding: 5px 12px;
        border-radius: 999px; cursor: pointer; white-space: nowrap;
        transition: background .15s, color .15s, border-color .15s;
      }
      .btn:hover { background: var(--terracotta); color: #fff; border-color: var(--terracotta); }
      .btn.done { background: #1f7a4d; color: #fff; border-color: #1f7a4d; }
      hr { border: 0; border-top: 1px solid var(--line); margin: 40px 0; }
      .tag {
        display: inline-block; font-size: 11px; font-weight: 700; letter-spacing: .06em;
        text-transform: uppercase; background: var(--terracotta); color: #fff;
        padding: 3px 9px; border-radius: 999px; vertical-align: middle; margin-left: 8px;
      }
      footer.page { margin-top: 56px; padding-top: 20px; border-top: 1px solid var(--line); font-size: 13px; color: var(--muted); }
    </style>
  </head>
  <body>
    <div class="wrap">
      <header class="page">
        <h1>WhatsApp Lead Scripts<span class="tag">Internal</span></h1>
        <p class="sub">India · ₹5,000 anchored offer · updated {updated}</p>
      </header>

      <p class="note">
        Use "I" throughout, never a mix of I/we. Reply within 15 minutes — speed beats wording.
        A perfect message four hours late loses to a decent one in ten minutes.
      </p>

      <p class="note"><strong>Policy: no free work.</strong> No free mockups, no free samples, no
        "let me design something and you decide". Proof comes from stores already built, never from
        work done for this lead before they pay. Anyone who only wants a free design is not a buyer.
      </p>

      <h2>Message order at a glance</h2>
      <ol class="order">
        <li>Anchor story (₹45,000 → ₹5,000)</li>
        <li>Proof + "what do you sell?"</li>
        <li><em>They reply</em></li>
        <li>Shopify fee disclosure</li>
        <li>Scoping questions + how I work</li>
        <li><em>They answer</em></li>
        <li>Written plan + portfolio proof</li>
        <li>Close with ₹2,500 advance</li>
      </ol>

      <hr />

      <h2>1 · Opening</h2>
      <p class="note">Send as two separate messages. Two short bubbles read as a person; one long block reads as a broadcast.</p>

      <h3>Message A — the story</h3>
      <div class="msg">
        <button class="copy" type="button">Copy</button>
        <pre>Hi! Mukesh here from Capaxe Labs 👋

My usual rate to build a Shopify store is ₹45,000.

I'm doing a limited number of stores at ₹5,000 right now — after that it goes back to normal pricing.</pre>
      </div>

      <h3>Message B — proof + the one ask <span style="font-weight:400;color:var(--muted);font-size:14px">(attach 2 store screenshots)</span></h3>
      <div class="msg">
        <button class="copy" type="button">Copy</button>
        <pre>Here's the kind of store I build ⬆️

Design, all pages, mobile-ready, handed over in 48 hours.

What do you sell? Just tell me the category and I'll tell you straight away if ₹5,000 covers it.</pre>
      </div>

      <hr />

      <h2>2 · Shopify fee — say it before they find it</h2>
      <p class="note">Send as soon as they reply. Must happen before the store-transfer step, or a paid project turns into a refund request. Check Shopify's current India promo so the number is accurate.</p>
      <div class="msg">
        <button class="copy" type="button">Copy</button>
        <pre>One thing so there are no surprises later:

The ₹5,000 is my fee — design, pages, setup, handover.

Shopify charges their own monthly plan directly (they usually run a heavily discounted first few months for new stores). I'll show you exactly what it costs before you commit to anything.</pre>
      </div>

      <hr />

      <h2>3 · Scoping — only after they've said what they sell</h2>
      <p class="note">Never send this as message 1 or 2. A stranger who tapped an ad 90 seconds ago will not fill a form. After they engage, it reads as professional scoping instead of a gate.</p>

      <h3>Bubble 1 — the questions</h3>
      <div class="msg">
        <button class="copy" type="button">Copy</button>
        <pre>Great, thanks! A few quick questions so I can scope this properly — these decide how big or small the build is:

1. How many products, roughly?
2. Any design or reference website you like?
3. Are you selling online anywhere already?
4. Do you have a domain name yet?

Rough answers are completely fine.</pre>
      </div>

      <h3>Bubble 2 — how I work</h3>
      <div class="msg">
        <button class="copy" type="button">Copy</button>
        <pre>Here's how I work:

1. You share the above, I scope it and confirm
2. ₹2,500 to start, I build the store and set up the structure
3. I transfer it to your Shopify account
4. I implement your design and specific requirements
5. ₹2,500 on handover, and a short review from you would mean a lot 🙏

Share as much detail as you can — the more I know, the better the fit.</pre>
      </div>

      <hr />

      <h2>4 · After they answer the scoping questions</h2>
      <p class="note">Send a <strong>plan</strong>, not a design. It costs ten minutes, it proves competence, and it does not hand over an asset before payment.</p>
      <div class="msg">
        <button class="copy" type="button">Copy</button>
        <pre>Got it — thanks 🙏

Here's what I'd build for you:

• Home, Shop, Product, About, Contact, Policies
• [their category] layout, mobile-first
• WhatsApp order button + payment setup
• Live in 48 hours from the day we start

₹5,000 total — ₹2,500 to start, ₹2,500 on handover.

Here's a store I built in a similar category ⬆️ Shall I block a slot for you?</pre>
      </div>
      <p class="note">Attach a real store link or screenshots. A finished store from the portfolio beats a mockup of theirs — it proves you <em>finish</em>, which is the actual doubt they have.</p>

      <hr />

      <h2>5 · The close</h2>
      <div class="msg">
        <button class="copy" type="button">Copy</button>
        <pre>If that looks right, send ₹2,500 to start and I'll have the store live in 48 hours.

[UPI ID / payment link]

Want me to block a slot for this week?</pre>
      </div>
      <p class="note">Splitting payment halves the perceived risk of buying from a stranger online. That split <em>is</em> the risk reversal — it replaces the free mockup entirely.</p>

      <hr />

      <h2>6 · Follow-ups for ghosts</h2>
      <p class="note">Two, then stop. Chasing further wastes your time and annoys people.</p>

      <h3>After ~24 hours</h3>
      <div class="msg">
        <button class="copy" type="button">Copy</button>
        <pre>Hey — still thinking about the store? Happy to answer anything before you decide 🙂</pre>
      </div>

      <h3>After ~72 hours</h3>
      <div class="msg">
        <button class="copy" type="button">Copy</button>
        <pre>Closing out this week's slots — I take a limited number at the ₹5,000 rate. Want me to hold one for you?</pre>
      </div>

      <hr />

      <h2>7 · Objection handling</h2>

      <h3>"Too expensive"</h3>
      <div class="msg">
        <button class="copy" type="button">Copy</button>
        <pre>Fair — for reference, agencies quote ₹40,000-₹1,00,000 for the same thing, and my own regular rate is ₹45,000. The ₹5,000 is a launch rate on a limited number of stores. It won't be available later.</pre>
      </div>

      <h3>"Can you do it cheaper?"</h3>
      <div class="msg">
        <button class="copy" type="button">Copy</button>
        <pre>Not at ₹5,000, sorry — it's already ~90% off my normal rate. What I can do is start with a simpler version and add pages later once you're selling.</pre>
      </div>
      <p class="note">Never discount below ₹5,000. ₹500 was already tested and attracted people who don't buy.</p>

      <h3>"Can you make a sample / mockup / demo first?" <span style="font-weight:400;color:var(--muted);font-size:14px">— the important one</span></h3>
      <div class="msg">
        <button class="copy" type="button">Copy</button>
        <pre>I don't do free mockups — at ₹5,000 the whole build is barely above a mockup's worth of work.

What I can do instead: ₹2,500 to start, and you see the real store, not a picture of one. If you're not happy with the design direction at that point, I'll rework it until you are.</pre>
      </div>
      <p class="note">Do not soften this. Free-mockup requests were the single biggest time sink in the last batch of leads, and none of them bought.</p>

      <h3>"Why so cheap? What's the catch?"</h3>
      <div class="msg">
        <button class="copy" type="button">Copy</button>
        <pre>No catch. It's a launch rate on a limited number of stores while I build up my portfolio. You get a ₹45,000 store for ₹5,000. That's the whole deal.</pre>
      </div>

      <h3>"I'll think about it"</h3>
      <div class="msg">
        <button class="copy" type="button">Copy</button>
        <pre>Of course. Anything specific you're unsure about — design, timeline, payment? Happy to answer.</pre>
      </div>

      <h3>"Can I see your past work?"</h3>
      <p class="note">This is the proof, and it is the <em>only</em> proof — nine finished, live stores beat any mockup you could make for them. Send immediately, and pick 2-3 that match what the lead sells. Nine links in one bubble reads as a brochure. Three chosen for them reads as attention. Full list in section 8.</p>
      <div class="msg">
        <button class="copy" type="button">Copy</button>
        <pre>Sure, here are a few stores I've built:

https://cld9.ai
https://dripcult.in
https://uniqstree.com

Happy to send more from your category if that's useful.</pre>
      </div>

      <hr />

      <h2>8 · Portfolio links</h2>
      <p class="note">Swap the three in the objection reply above for whichever fit the lead. Apparel leads get apparel stores, food leads get food stores. Keep this list current as new stores go live.</p>

      <h3>All links <span style="font-weight:400;color:var(--muted);font-size:14px">(copyable)</span></h3>
      <div class="msg">
        <button class="copy" type="button">Copy</button>
        <pre>https://cld9.ai
https://locaboca.in
https://uniqstree.com
https://vaidique.com
https://dripcult.in
https://kosherfoodineurope.com
https://kranium.in
https://pestie.com
https://renumumbai.com</pre>
      </div>

      <h3>Quick open</h3>
      <ul class="rules">
        <li><a href="https://cld9.ai" target="_blank" rel="noopener noreferrer">cld9.ai</a></li>
        <li><a href="https://locaboca.in" target="_blank" rel="noopener noreferrer">locaboca.in</a></li>
        <li><a href="https://uniqstree.com" target="_blank" rel="noopener noreferrer">uniqstree.com</a></li>
        <li><a href="https://vaidique.com" target="_blank" rel="noopener noreferrer">vaidique.com</a></li>
        <li><a href="https://dripcult.in" target="_blank" rel="noopener noreferrer">dripcult.in</a></li>
        <li><a href="https://kosherfoodineurope.com" target="_blank" rel="noopener noreferrer">kosherfoodineurope.com</a></li>
        <li><a href="https://kranium.in" target="_blank" rel="noopener noreferrer">kranium.in</a></li>
        <li><a href="https://pestie.com" target="_blank" rel="noopener noreferrer">pestie.com</a></li>
        <li><a href="https://renumumbai.com" target="_blank" rel="noopener noreferrer">renumumbai.com</a></li>
      </ul>

      <hr />

      <h2>9 · App review links</h2>
      <p class="note">
        These open the App Store listing with the review box already showing, so the merchant lands
        one tap away from writing. They need to be signed in to the Shopify account that installed
        the app, otherwise the box will not appear for them.
      </p>
      <p class="note">
        <strong>Never offer anything in exchange for a review.</strong> No discounts, no free months,
        no credits. Shopify removes incentivised reviews and it puts the listing at risk. Ask only
        after the app has actually done something useful for them.
      </p>

      <h3>Per app <span style="font-weight:400;color:var(--muted);font-size:14px">(Link = bare URL, Message = ready to send)</span></h3>
      {reviewApps.map((app) => (
        <div class="row">
          <span class="app">{app.name}</span>
          <span class="url"><a href={reviewUrl(app.slug)} target="_blank" rel="noopener noreferrer">{reviewUrl(app.slug)}</a></span>
          <button class="btn" type="button" data-copy={reviewUrl(app.slug)}>Link</button>
          <button
            class="btn"
            type="button"
            data-copy={`Hi! Glad ${app.name} has been useful for ${app.blurb} 🙏

If you have a spare minute, a short review would genuinely help us:
${reviewUrl(app.slug)}

That link opens the review box directly. Thank you!`}
          >Message</button>
        </div>
      ))}

      <h3>All links at once <span style="font-weight:400;color:var(--muted);font-size:14px">(for a doc or team channel, never send this to a merchant)</span></h3>
      <div class="msg">
        <button class="copy" type="button">Copy</button>
        <pre>{reviewApps.map((app) => `${app.name}:\n${reviewUrl(app.slug)}`).join("\n\n")}</pre>
      </div>

      <h3>Follow-up if they said yes but never did it</h3>
      <p class="note">Once, then drop it. A second nudge costs more goodwill than the review is worth.</p>
      <div class="msg">
        <button class="copy" type="button">Copy</button>
        <pre>No rush at all on that review, just floating the link back up in case it got buried 🙂</pre>
      </div>

      <hr />

      <h2>Rules</h2>
      <ul class="rules">
        <li><strong>Reply within 15 minutes.</strong> Speed beats wording.</li>
        <li><strong>Never ask two questions in one message</strong> — except section 3, which is deliberate and comes only after engagement.</li>
        <li><strong>Never lead with a question.</strong> Lead with the anchor and the proof.</li>
        <li><strong>Say the Shopify fee before they ask</strong>, and always before the transfer step.</li>
        <li><strong>Never do free work.</strong> No mockups, no samples, no "just a quick design". Proof = finished stores. Risk reversal = the 50/50 split.</li>
        <li><strong>Voice notes work well in India</strong> once a lead is engaged.</li>
        <li><strong>Track per lead:</strong> which ad they came from, whether they replied to message 2, whether they paid.</li>
      </ul>

      <footer class="page">
        Internal page — noindex, excluded from sitemap, not linked from anywhere on the site.
      </footer>
    </div>

    <script>
      // Buttons carrying their own text (section 9 per-app links and messages).
      document.querySelectorAll("[data-copy]").forEach((btn) => {
        btn.addEventListener("click", async () => {
          const text = btn.getAttribute("data-copy") || "";
          try {
            await navigator.clipboard.writeText(text);
          } catch (e) {
            const ta = document.createElement("textarea");
            ta.value = text;
            ta.style.position = "fixed";
            ta.style.opacity = "0";
            document.body.appendChild(ta);
            ta.select();
            document.execCommand("copy");
            document.body.removeChild(ta);
          }
          const original = btn.textContent;
          btn.textContent = "Copied";
          btn.classList.add("done");
          setTimeout(() => {
            btn.textContent = original;
            btn.classList.remove("done");
          }, 1500);
        });
      });

      document.querySelectorAll(".copy").forEach((btn) => {
        btn.addEventListener("click", async () => {
          const pre = btn.parentElement.querySelector("pre");
          if (!pre) return;
          try {
            await navigator.clipboard.writeText(pre.textContent.trim());
          } catch (e) {
            const r = document.createRange();
            r.selectNodeContents(pre);
            const s = window.getSelection();
            s.removeAllRanges();
            s.addRange(r);
            document.execCommand("copy");
            s.removeAllRanges();
          }
          const original = btn.textContent;
          btn.textContent = "Copied";
          btn.classList.add("done");
          setTimeout(() => {
            btn.textContent = original;
            btn.classList.remove("done");
          }, 1500);
        });
      });
    </script>
  </body>
</html>
