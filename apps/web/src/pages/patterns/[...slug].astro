---
import { getCollection, render, type CollectionEntry } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import BuildRoutes from "@/components/BuildRoutes.astro";
import FormattedDate from "@/components/FormattedDate.astro";
import CTABottom from "@/components/CTA.astro";
import { createSEO } from "@/utils/seo";
import type { SEOProps } from "@/utils/seo";
import { getBreadcrumbSchema } from "@/lib/schemas";
import { siteConfig } from "@/config/site";

export const prerender = true;

export async function getStaticPaths() {
  const patterns = await getCollection("patterns", ({ data }) => !data.draft);
  return patterns.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}

type Props = { entry: CollectionEntry<"patterns"> };

const { entry } = Astro.props;
const { Content } = await render(entry);

const related = (await getCollection("patterns", ({ data }) => !data.draft)).filter((p) =>
  entry.data.related.includes(p.data.slug),
);

const seo: SEOProps = createSEO({
  pageName: entry.data.title,
  description: entry.data.description,
  publishDate: new Date(entry.data.pubDate),
  updateDate: entry.data.updatedDate ? new Date(entry.data.updatedDate) : undefined,
  contentType: "blog",
  pathname: Astro.url.pathname,
});

seo.structuredData = [
  seo.structuredData as object,
  getBreadcrumbSchema([
    { name: "Home", url: siteConfig.url },
    { name: "Patterns", url: `${siteConfig.url}/patterns` },
    { name: entry.data.title, url: `${siteConfig.url}${Astro.url.pathname}` },
  ]),
];
---

<Layout seo={seo}>
  <div class="min-h-screen">
    <section class="px-6 pt-32 pb-8">
      <div class="mx-auto max-w-3xl">
        <div class="mb-6 flex items-center gap-2 text-sm text-muted-foreground">
          <a href="/patterns" class="transition-colors hover:text-primary-400">Patterns</a>
          <span class="text-border">/</span>
          <span class="truncate">{entry.data.title}</span>
        </div>

        <h1 class="mb-6 text-4xl font-bold leading-tight text-foreground md:text-5xl">
          {entry.data.title}
        </h1>

        <p class="mb-6 text-lg leading-relaxed text-muted-foreground">{entry.data.problem}</p>

        <div class="flex flex-wrap items-center gap-3">
          <span
            class="inline-flex items-center rounded-full bg-primary-500/10 px-3 py-1 text-sm font-medium text-primary-400"
          >
            <FormattedDate date={entry.data.pubDate} />
          </span>
          {
            entry.data.updatedDate && (
              <span class="inline-flex items-center rounded-full bg-muted px-3 py-1 text-sm text-muted-foreground">
                Updated: <FormattedDate date={entry.data.updatedDate} />
              </span>
            )
          }
        </div>
      </div>
    </section>

    <article class="mx-auto max-w-3xl px-6 py-8">
      <div class="blog-content text-foreground">
        <Content />
      </div>

      {entry.data.routes.length > 0 && <BuildRoutes routes={entry.data.routes} />}

      {
        related.length > 0 && (
          <section class="mt-16">
            <h2 class="mb-4 border-b border-border pb-2 text-sm font-semibold uppercase tracking-wider text-muted-foreground">
              Related patterns
            </h2>
            <ul class="m-0 flex list-none flex-wrap gap-2 p-0">
              {related.map((p) => (
                <li>
                  <a
                    href={`/patterns/${p.data.slug}`}
                    class="inline-block rounded-full border border-border bg-card px-3 py-1.5 text-sm text-muted-foreground no-underline transition-colors hover:border-primary-500 hover:text-primary-400"
                  >
                    {p.data.title}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      <div class="mt-16 border-t border-border pt-8">
        <a
          href="/patterns"
          class="inline-flex items-center gap-2 text-sm font-medium text-primary-400 transition-colors hover:text-primary-300"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-4 w-4"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          All patterns
        </a>
      </div>
    </article>
  </div>
  <CTABottom />
</Layout>
