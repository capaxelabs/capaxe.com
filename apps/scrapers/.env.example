# Copy to .env and fill in the token. Everything else has sane defaults.

# Cloudflare D1 sync target (account + database ids are not secrets).
CF_ACCOUNT_ID=81cac75fe318d80f4344481afc4799ac
CF_D1_DATABASE_ID=39f53b08-1ea9-4621-8704-e36b6b02ef27
# API token with D1:Edit on this account — create at
# https://dash.cloudflare.com/profile/api-tokens
CF_API_TOKEN=

# Optional overrides (defaults shown).
# ENRICH_ENABLED=1
# ENRICH_BATCH=50
# ENRICH_PAUSE_MS=5000
# ENRICH_IDLE_MS=600000
# JUDGEME_ENABLED=1
# JUDGEME_INTERVAL_MS=300000
# JUDGEME_LIMIT=10
# SYNC_ENABLED=1
# SYNC_INTERVAL_MS=300000
# SYNC_DRY_RUN=0
# PORT=8787
